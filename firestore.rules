rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isValidPin(pin) {
      return pin is string && pin.size() == 4 && pin.matches('^[0-9]{4}$');
    }

    function isAdminTeacher() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email == 'hanselaa@gmail.com';
    }

    // Classroom session document keyed by 4-digit PIN
    match /classrooms/{pin} {
      allow read: if true;

      allow create, delete: if isValidPin(pin) && isAdminTeacher();

      allow update: if isValidPin(pin) && (
        isAdminTeacher()
        || (
          request.resource.data.pin == resource.data.pin
          && request.resource.data.worldSetup == resource.data.worldSetup
        )
      );

      // Student telemetry documents inside a valid 4-digit PIN session
      match /students/{studentId} {
        allow read, write: if isValidPin(pin);
      }

      // Multiplayer world player slices inside a valid 4-digit PIN session
      match /worlds/{worldId} {
        allow read: if isValidPin(pin);

        match /players/{playerId} {
          allow read, write: if isValidPin(pin);
        }
      }
    }

    // Lock down all other collections and documents
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
